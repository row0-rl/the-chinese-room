    "roomsOrderingFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned rooms come first. Other rooms are ordered by recent use when you open the app. Hold a room to pin, rename, or archive it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les espaces épinglés viennent en premier. Les autres sont triés par utilisation récente à l’ouverture de l’app. Maintenez un espace pour l’épingler, le renommer ou l’archiver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "置顶房间排在最前。其他房间在打开应用时按最近使用排序。长按房间可置顶、重命名或归档。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 방이 먼저 표시됩니다. 다른 방은 앱을 열 때 최근 사용순으로 정렬됩니다. 길게 누르면 고정, 이름 변경, 보관할 수 있습니다."
          }
        }
      }
    },
